#!/usr/bin/env bash
# preview-url: start/stop/show a public preview for the current task worktree.
#   preview-url start [command]   start the dev server (default: auto-detect) and print the public URL
#   preview-url stop              stop it and unregister
#   preview-url url               print the URL if registered
#   preview-url list              all registered previews
# Slug = issue identifier from the branch name (GRA-28-foo -> gra-28), else directory name.
set -euo pipefail
REG=/home/paperclip/preview-registry.json
BASE=187-126-114-172.sslip.io
LOGDIR=/home/paperclip/preview-logs; mkdir -p "$LOGDIR"
[ -f "$REG" ] || echo "{}" > "$REG"

branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || true)
slug=$(printf '%s' "${branch:-$(basename "$PWD")}" | grep -oiE '^[a-z]+-[0-9]+' | tr 'A-Z' 'a-z' || true)
[ -n "$slug" ] || slug=$(basename "$PWD" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9\n' '-' | cut -c1-40)
url="https://$slug.$BASE"

jq_set() { python3 - "$REG" "$@" <<'PY'
import json,sys
p=sys.argv[1]; op=sys.argv[2]; slug=sys.argv[3]
r=json.load(open(p))
if op=="set": r[slug]={"port":int(sys.argv[4]),"cwd":sys.argv[5],"pid":int(sys.argv[6]),"startedAt":sys.argv[7],"lastHit":None}
elif op=="del": r.pop(slug,None)
json.dump(r,open(p,"w"),indent=2)
PY
}
free_port() { python3 - <<'PY'
import socket,random
for _ in range(50):
    p=random.randint(4100,4999); s=socket.socket()
    try: s.bind(("127.0.0.1",p)); s.close(); print(p); break
    except OSError: pass
PY
}

case "${1:-url}" in
  start)
    if [ -f "$LOGDIR/$slug.pid" ] && kill -0 "$(cat "$LOGDIR/$slug.pid")" 2>/dev/null; then echo "$url"; exit 0; fi
    port=$(free_port)
    cmd="${2:-}"
    if [ -z "$cmd" ]; then
      if [ -f package.json ] && grep -q '"dev"' package.json; then
        if grep -q '"next' package.json; then cmd="npx next dev -p $port -H 127.0.0.1";
        elif grep -q '"vite' package.json; then cmd="npx vite --port $port --host 127.0.0.1 --strictPort";
        else cmd="PORT=$port npm run dev"; fi
      elif [ -f manage.py ]; then cmd="python3 manage.py runserver 127.0.0.1:$port";
      else echo "cannot auto-detect a dev command; pass one: preview-url start '<command>'" >&2; exit 2; fi
    fi
    PORT=$port setsid bash -c "exec $cmd" >"$LOGDIR/$slug.log" 2>&1 < /dev/null &
    pid=$!; echo $pid > "$LOGDIR/$slug.pid"
    jq_set set "$slug" "$port" "$PWD" "$pid" "$(date -u +%FT%TZ)"
    for _ in $(seq 1 90); do sleep 1; curl -s -o /dev/null "http://127.0.0.1:$port/" && break; done
    curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:$port/" | grep -qE '^[2345]' || echo "warning: server not answering yet, log: $LOGDIR/$slug.log" >&2
    echo "$url"
    ;;
  stop)
    [ -f "$LOGDIR/$slug.pid" ] && { pkill -TERM -s "$(cat "$LOGDIR/$slug.pid")" 2>/dev/null || kill "$(cat "$LOGDIR/$slug.pid")" 2>/dev/null || true; rm -f "$LOGDIR/$slug.pid"; }
    jq_set del "$slug"; echo "stopped $slug"
    ;;
  url) python3 -c "import json;r=json.load(open('$REG'));print('$url' if '$slug' in r else 'not running')" ;;
  list) cat "$REG" ;;
  *) echo "usage: preview-url start [cmd] | stop | url | list" >&2; exit 1 ;;
esac
