#!/bin/sh
# git credential helper: per-person tokens for https remotes (installed as ~/.local/bin/git-credential-identity,
# wired in ~/.gitconfig as  [credential "https://<host>"] helper = /home/paperclip/.local/bin/git-credential-identity).
# Files: ~/.git-identities/<host>/<identity>  (mode 600, one line "username:token"; <identity> is usually an email).
# Identity: $GIT_IDENTITY, else the "default" link in that host directory. No file → no credentials (git fails cleanly).
[ "$1" = get ] || exit 0
host=
while IFS= read -r line; do
  case "$line" in host=*) host=${line#host=} ;; esac
done
[ -n "$host" ] || exit 0
f="$HOME/.git-identities/$host/${GIT_IDENTITY:-default}"
[ -r "$f" ] || exit 0
IFS=: read -r user tok < "$f"
[ -n "$user" ] && [ -n "$tok" ] || exit 0
printf 'username=%s\npassword=%s\n' "$user" "$tok"
