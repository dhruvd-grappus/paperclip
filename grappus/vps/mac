#!/bin/bash
# mac: build and run things on registered Mac machines (Xcode, Swift, iOS/macOS, Flutter iOS) from the VPS.
# Installed at /usr/local/bin/mac (make install-mac); runs as paperclip. Macs are reached with plain ssh over
# Tailscale (the VPS and every Mac sit in one tailnet); nothing is exposed publicly.
# Registry: /home/paperclip/macs.json  {"macs":{"<name>":{"host","user","workdir","note"}}}
# Key:      /home/paperclip/.ssh/mac_builder (ed25519, created by `mac pubkey`), authorised on each Mac.
# `mac help` is the manual (agents read it there).
set -uo pipefail
export HOME=/home/paperclip
REG=${MAC_REGISTRY:-$HOME/macs.json}
KEY=${MAC_KEY:-$HOME/.ssh/mac_builder}
[ -s "$REG" ] || echo '{"macs":{}}' > "$REG"

die() { echo "mac: $*" >&2; exit 1; }
field() { jq -r --arg n "$1" --arg f "$2" '.macs[$n][$f] // empty' "$REG"; }
need() { jq -e --arg n "$1" '.macs[$n]' "$REG" >/dev/null || die "no mac named '$1' (mac list)"; }
SSHO=(-i "$KEY" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new -o ServerAliveInterval=30)
# Tailnet view: one line per node "<name> <ip> <os> <online>", name = first label of the MagicDNS name. Names resolve through it,
# so a Mac is reachable by its Tailscale name without MagicDNS on this host.
TS=$(tailscale status --json 2>/dev/null | jq -r '[.Self] + [.Peer[]?] | .[] | "\(.DNSName|split(".")[0]|ascii_downcase) \(.TailscaleIPs[0]) \(.OS) \(.Online)"')
node() { awk -v h="$(echo "$1" | tr A-Z a-z)" '$1==h || $2==h' <<<"$TS" | head -1; }
ip() { local h; h=$(field "$1" host); local l; l=$(node "$h"); [ -n "$l" ] && echo "${l#* }" | cut -d' ' -f1 || echo "$h"; }
online() { [ "$(node "$(field "$1" host)" | cut -d' ' -f4)" = true ]; }
need_online() { online "$1" || die "$1 is offline in Tailscale: nothing to do on it (mac list)"; }
target() { echo "$(field "$1" user)@$(ip "$1")"; }
workdir() { local w; w=$(field "$1" workdir); echo "${w:-paperclip-builds}"; }
# remote: run a command string in a login zsh (brew, flutter, pod on PATH) from the Mac user's home.
# nvm lives in .zshrc, which a non-interactive login shell skips: load it when the Mac has it (node, npx, pnpm, yarn).
remote() { local n=$1; shift; ssh "${SSHO[@]}" "$(target "$n")" "zsh -lc $(printf %q "[ -s \$HOME/.nvm/nvm.sh ] && . \$HOME/.nvm/nvm.sh >/dev/null 2>&1; $*")"; }

# One persistent build clone per repo on each Mac, named after the origin remote (ateam, not GRA-123-foo), shared by
# every task and worktree of that repo, so Pods and DerivedData stay warm and each build only recompiles the diff.
repo_key() { local u; u=$(git -C "$1" remote get-url origin 2>/dev/null); u=${u%.git}; u=${u##*/}; echo "${u:-$(basename "$(cd "$1" && pwd)")}"; }
# Tasks take turns on a clone: flock on this host (the only driver) per Mac + repo, held until the command exits.
lock() { [ -d "$2" ] || die "no dir $2"; mkdir -p "$HOME/.mac-locks"; exec 9>"$HOME/.mac-locks/$1-$(repo_key "$2").lock"
  flock -n 9 || { echo "mac: $1 is busy with another $(repo_key "$2") build, waiting (max 20 min)" >&2; flock -w 1200 9 || die "gave up waiting for $1"; }; }
# Content-only compare (-c) and no -t: unchanged files keep their Mac mtimes even when the worktree is brand new,
# otherwise Xcode would see every file as modified and rebuild from scratch.
# The repo's .gitignore decides what travels: ignored paths are neither sent nor deleted on the Mac, so what the Mac
# generates itself (Pods, Flutter build/ and .dart_tool, Expo's generated ios/, node_modules) survives every sync and
# builds stay warm. Tracked files that match an ignore rule are still sent (git ls-files -ci), unless a whole ignored
# directory holds them (Pods: the Mac runs pod install instead).
# Expo (continuous native generation): `expo prebuild` writes ios/ and android/ on the Mac; when the repo neither
# tracks nor ignores them they would be deleted by the next sync, so they are protected there.
# WITH_ENV=1 (mac sync|build|sim run --with-env): also send the worktree's secret build config (.env*, Firebase plists)
# that .gitignore keeps back. Only when the requester allowed it for that Mac: values leave this host.
sync_to() { local n=$1 src=$2 dest inc d; dest="$(workdir "$n")/$(repo_key "$src")"
  remote "$n" "mkdir -p $(printf %q "$dest")" || die "ssh to $n failed (mac check $n)"
  inc=$(mktemp); git -C "$src" ls-files -ci --exclude-standard 2>/dev/null | sed 's#^#/#' > "$inc"
  if [ "${WITH_ENV:-}" = 1 ]; then (cd "$src" && find . -path ./node_modules -prune -o -path ./.git -prune -o -type f \( -name '.env*' -o -name GoogleService-Info.plist -o -name google-services.json \) -print | sed 's#^\.##') >> "$inc"; fi
  local prot=()
  while read -r d; do d=${d%/package.json}; d=${d#.}; for x in ios android; do
      [ -n "$(git -C "$src" ls-files "${d#/}${d:+/}$x" 2>/dev/null | head -1)" ] || prot+=(--filter="P $d/$x/"); done
  done < <(cd "$src" && grep -l '"expo"' $(find . -maxdepth 3 -name package.json -not -path '*/node_modules/*') 2>/dev/null)
  rsync -rlc --delete -e "ssh ${SSHO[*]}" "${prot[@]+"${prot[@]}"}" --include-from="$inc" --filter=':- .gitignore' \
    --exclude .git --exclude node_modules --exclude DerivedData --exclude Pods/ \
    "${src%/}/" "$(target "$n"):$dest/" >&2 || { rm -f "$inc"; die "rsync failed"; }
  rm -f "$inc"; echo "$dest"; }

set_fields() { # $1 name, rest: --host/--user/--workdir/--note pairs
  local n=$1; shift; local args=()
  while [ $# -gt 0 ]; do case "$1" in
    --host|--user|--workdir|--note) [ $# -ge 2 ] || die "$1 needs a value"; args+=(--arg "${1#--}" "$2"); shift 2;;
    *) die "unknown option $1";; esac; done
  local tmp; tmp=$(mktemp)
  jq --arg n "$n" "${args[@]}" '.macs[$n] = ((.macs[$n] // {}) + ($ARGS.named | del(.n)))' "$REG" > "$tmp" && mv "$tmp" "$REG"
}

cmd=${1:-list}; shift || true
case "$cmd" in
  list) # registered Macs with Tailscale state; exit 1 when none is online (= nothing to do)
    up=0; rows=""
    while IFS=$'\t' read -r n rest; do [ -n "$n" ] || continue
      if online "$n"; then st=online; up=$((up+1)); else st=offline; fi
      rows+="$n"$'\t'"$st"$'\t'"$rest"$'\n'
    done < <(jq -r '.macs | to_entries[] | "\(.key)\t\(.value.user)@\(.value.host)\t\(.value.note // "")"' "$REG")
    [ -n "$rows" ] && printf '%s' "$rows" | column -t -s $'\t'
    reg=$(jq -r '.macs[].host | ascii_downcase' "$REG")
    other=$(awk '$3=="macOS"{print $1" ("($4=="true"?"online":"offline")")"}' <<<"$TS" | grep -vxF -f <(sed 's/$/ (online)/;p;s/(online)/(offline)/' <<<"$reg") | paste -sd, -)
    [ -n "$other" ] && echo "tailnet Macs not registered (mac add): $other"
    [ "$up" -gt 0 ] || { echo "no Mac online: nothing to do"; exit 1; };;
  add)
    n=${1:?mac add <name> --host <tailscale name|100.x ip> --user <mac user> [--workdir <dir>] [--note <text>]}; shift
    jq -e --arg n "$n" '.macs[$n]' "$REG" >/dev/null && die "'$n' exists (mac edit)"
    set_fields "$n" "$@"
    [ -n "$(field "$n" host)" ] && [ -n "$(field "$n" user)" ] || { jq --arg n "$n" 'del(.macs[$n])' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"; die "--host and --user are required"; }
    echo "added $n"; echo "authorise the key on it: mac pubkey";;
  edit)
    n=${1:?mac edit <name> [--host h] [--user u] [--workdir d] [--note t]}; shift; need "$n"; set_fields "$n" "$@"; echo "updated $n";;
  remove)
    n=${1:?mac remove <name>}; need "$n"
    jq --arg n "$n" 'del(.macs[$n])' "$REG" > "$REG.tmp" && mv "$REG.tmp" "$REG"; echo "removed $n";;
  pubkey)
    [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -C paperclip-mac-builder -f "$KEY"
    echo "On the Mac (Remote Login on, Tailscale in the same tailnet), as the build user, run:"
    echo "  mkdir -p ~/.ssh && chmod 700 ~/.ssh && echo '$(cat "$KEY.pub")' >> ~/.ssh/authorized_keys && chmod 600 ~/.ssh/authorized_keys";;
  check)
    names=("$@"); [ $# -gt 0 ] || mapfile -t names < <(jq -r '.macs|keys[]' "$REG")
    for n in "${names[@]}"; do need "$n"
      printf '%s (%s): ' "$n" "$(target "$n")"; online "$n" || { echo offline; continue; }
      remote "$n" 'echo "ok macOS $(sw_vers -productVersion), $(xcodebuild -version 2>/dev/null | head -1 || echo "no Xcode"), $(df -h ~ | awk "NR==2{print \$4}") free"' 2>&1 | tail -1
    done;;
  run)
    n=${1:?mac run <name> -- <command>}; shift; need "$n"; need_online "$n"; [ "${1:-}" = "--" ] && shift
    [ $# -gt 0 ] || die "no command"; w=$(printf %q "$(workdir "$n")"); remote "$n" "mkdir -p $w && cd $w && $*";;
  sync)
    n=${1:?mac sync <name> <local dir>}; src=${2:?mac sync <name> <local dir>}; need "$n"; need_online "$n"
    [ "${3:-}" = --with-env ] && WITH_ENV=1; lock "$n" "$src"; sync_to "$n" "$src";;
  build)
    n=${1:?mac build <name> <local dir> [--path P] [--scheme S] [--dest D] [-- extra xcodebuild args]}; src=${2:?local dir}; shift 2; need "$n"; need_online "$n"
    scheme=""; dest="generic/platform=iOS Simulator"; extra=(); sub=.
    while [ $# -gt 0 ]; do case "$1" in
      --scheme) scheme=$2; shift 2;; --path) sub=$2; shift 2;; --dest) dest=$2; shift 2;; --with-env) WITH_ENV=1; shift;; --) shift; extra=("$@"); break;;
      *) die "unknown option $1";; esac; done
    lock "$n" "$src"; rdir=$(sync_to "$n" "$src") || exit 1
    log="$HOME/mac-logs/$(basename "$rdir")-$(date +%Y%m%d-%H%M%S).log"; mkdir -p "$HOME/mac-logs"
    # xcworkspace (CocoaPods/SPM) beats xcodeproj; no --scheme = the first scheme xcodebuild lists.
    x=""; [ ${#extra[@]} -gt 0 ] && x=$(printf '%q ' "${extra[@]}")
    script="dd=\$(cd $(printf %q "$(dirname "$rdir")") && pwd)/DerivedData/$(basename "$rdir")
      cd $(printf %q "$rdir/$sub") || exit 1
      c=\$(ls -d *.xcworkspace 2>/dev/null | grep -v '^Pods' | head -1); k=-workspace
      [ -n \"\$c\" ] || { c=\$(ls -d *.xcodeproj 2>/dev/null | head -1); k=-project; }
      [ -n \"\$c\" ] || { echo \"no .xcworkspace or .xcodeproj in \$PWD: pass --path <dir holding it> (Flutter/Expo/RN: mac sim run)\"; exit 3; }
      # Pods never sync (repos commit them partially, without the big binary slices): the Mac installs its own,
      # again only when Podfile.lock moves. Uses the Mac's CocoaPods cache.
      if [ -f Podfile ] && ! cmp -s Podfile.lock Pods/Manifest.lock; then pod install || exit 1; fi
      s=$(printf %q "$scheme"); [ -n \"\$s\" ] || s=\$(xcodebuild -list \$k \"\$c\" -json | python3 -c 'import json,sys;d=json.load(sys.stdin);print((d.get(\"workspace\") or d.get(\"project\"))[\"schemes\"][0])')
      echo \"xcodebuild \$k \$c -scheme \$s\"
      xcodebuild \$k \"\$c\" -scheme \"\$s\" -destination $(printf %q "$dest") -derivedDataPath \"\$dd\" CODE_SIGNING_ALLOWED=NO ARCHS=\$(uname -m) ONLY_ACTIVE_ARCH=YES build $x"
    remote "$n" "$script" > "$log" 2>&1; rc=$?
    grep -m1 '^xcodebuild ' "$log"; grep -E '(fatal )?error:' "$log" | sort -u | head -15
    tail -3 "$log"; echo "log: $log"; exit $rc;;
  sim) # simulator control on one Mac; serialised per Mac (one booted simulator, shared by all tasks)
    n=${1:?mac sim <name> <action> ...}; a=${2:?mac sim <name> devices|boot|shutdown|install|reinstall|launch|terminate|screenshot|openurl|hierarchy|flow}; shift 2
    need "$n"; need_online "$n"; mkdir -p "$HOME/.mac-locks"; exec 8>"$HOME/.mac-locks/$n-sim.lock"
    flock -n 8 || { echo "mac: simulator on $n busy, waiting (max 20 min)" >&2; flock -w 1200 8 || die "gave up waiting for $n simulator"; }
    w=$(workdir "$n"); ts=$(date +%Y%m%d-%H%M%S); art="$w/sim-artifacts/$ts"; out="$HOME/mac-logs/sim/$ts"
    # app of a repo: newest simulator *.app from `mac build` (DerivedData) or from a Flutter/RN build inside the clone
    app_of() { local r=$1; [ -d "$r" ] && r=$(repo_key "$r"); echo "app=\$(ls -td $(printf %q "$w")/DerivedData/$(printf %q "$r")/Build/Products/${cfg:-*}-iphonesimulator/*.app \$(find $(printf %q "$w/$r") -maxdepth 7 -type d -path '*iphonesimulator/*.app' -not -path '*/*.app/*' -not -path '*/node_modules/*' 2>/dev/null) 2>/dev/null | head -1)
      [ -n \"\$app\" ] || { echo 'no simulator build for $r: run mac build first' >&2; exit 3; }
      bid=\$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' \"\$app/Info.plist\")"; }
    find_booted='dev=$(xcrun simctl list devices booted -j | python3 -c "import json,sys;d=[x for v in json.load(sys.stdin)[\"devices\"].values() for x in v];print(d[0][\"udid\"] if d else \"\")")'
    booted="$find_booted"'
      [ -n "$dev" ] || { echo "no simulator booted: mac sim <mac> boot" >&2; exit 3; }'
    java='export PATH="$HOME/.maestro/bin:$PATH"; for j in /opt/homebrew/opt/openjdk@17 /opt/homebrew/opt/openjdk /usr/local/opt/openjdk@17; do [ -x $j/bin/java ] && export JAVA_HOME=$j && break; done'
    pull() { mkdir -p "$out"; rsync -r -e "ssh ${SSHO[*]}" "$(target "$n"):$art/" "$out/" && echo "artifacts: $out" && ls "$out" | head -20; }
    cfg=""; except=""; sub=.; args=(); while [ $# -gt 0 ]; do case "$1" in --config) cfg=$2; shift 2;; --except) except=$2; shift 2;; --path) sub=$2; shift 2;; --with-env) WITH_ENV=1; shift;; *) args+=("$1"); shift;; esac; done; set -- "${args[@]+"${args[@]}"}"
    case "$a" in
      devices) remote "$n" 'xcrun simctl list devices available | grep -E "^--|iPhone|iPad"';;
      boot) # [device name|udid] [--except cats]: always a slim simulator (simslim: ~170 background daemons off, ~4x less RAM).
        # Default device: the booted one, else iPhone 16 Pro, else the last available iPhone. Opens the Simulator window.
        d=$(printf %q "${1:-}"); ex=$(printf %q "$except")
        remote "$n" "command -v simslim >/dev/null || { echo 'simslim missing on this Mac: brew install mobai-app/tap/simslim' >&2; exit 3; }
          want=$d; ex=$ex; $find_booted
          if [ -z \"\$dev\" ] || [ -n \"\$want\" ]; then dev=\$(xcrun simctl list devices available -j | python3 -c 'import json,sys
w=sys.argv[1]; d=[x for k,v in sorted(json.load(sys.stdin)[\"devices\"].items()) if \"iOS\" in k for x in v]
m=[x for x in d if w in (x[\"name\"],x[\"udid\"])] if w else [x for x in d if x[\"state\"]==\"Booted\"] or [x for x in d if x[\"name\"]==\"iPhone 16 Pro\"] or [x for x in d if x[\"name\"].startswith(\"iPhone\")]
print(m[-1][\"udid\"] if m else \"\")' \"\$want\"); [ -n \"\$dev\" ] || { echo 'no such simulator (mac sim <mac> devices)'; exit 3; }; fi
          for u in \$(xcrun simctl list devices booted -j | python3 -c 'import json,sys;[print(x[\"udid\"]) for v in json.load(sys.stdin)[\"devices\"].values() for x in v]'); do [ \$u = \$dev ] || xcrun simctl shutdown \$u; done   # one simulator per Mac
          slim=\$(simslim list --json | python3 -c 'import json,sys;print(next((x.get(\"managedDisabled\",0) for x in json.load(sys.stdin) if x[\"udid\"]==sys.argv[1]),0))' \$dev)
          if [ \"\$slim\" = 0 ] || [ -n \"\$ex\" ]; then simslim on \$dev \${ex:+--except} \${ex:+\$ex} >/dev/null || exit 1   # slims + (re)boots
          else simslim boot \$dev >/dev/null 2>&1 || true; fi
          open -a Simulator --args -CurrentDeviceUDID \$dev
          simslim list --json | python3 -c 'import json,sys
x=next(x for x in json.load(sys.stdin) if x[\"udid\"]==sys.argv[1]); m=x.get(\"memory\") or {}
print(x[\"name\"], x[\"osVersion\"], x[\"udid\"], x[\"state\"], \"slim %s/%s daemons off\" % (x.get(\"managedDisabled\",0), x[\"managedTotal\"]), \"%d MB\" % (m.get(\"bytes\",0)/1e6))' \$dev";;
      shutdown) remote "$n" 'xcrun simctl shutdown all && echo shut down';;
      install|reinstall|launch|terminate) # <repo|worktree> [--config Debug-Dev]
        r=${1:?mac sim <name> $a <repo|worktree>}; s=$(app_of "$r")
        case "$a" in
          install) act='xcrun simctl install $dev "$app" && echo "installed $bid from $app"';;
          reinstall) act='xcrun simctl terminate $dev $bid 2>/dev/null; xcrun simctl uninstall $dev $bid; xcrun simctl install $dev "$app" && xcrun simctl launch $dev $bid && echo "reinstalled (fresh data) + launched $bid"';;
          launch) act='xcrun simctl launch --terminate-running-process $dev $bid';;
          terminate) act='xcrun simctl terminate $dev $bid && echo terminated $bid';;
        esac
        remote "$n" "$booted
          $s
          $act";;
      screenshot) remote "$n" "$booted; mkdir -p $art && xcrun simctl io \$dev screenshot $art/screen.png >/dev/null" && pull;;
      openurl) u=${1:?mac sim <name> openurl <url>}; remote "$n" "$booted; xcrun simctl openurl \$dev $(printf %q "$u") && echo opened";;
      hierarchy) remote "$n" "$booted; $java; maestro --device \$dev hierarchy --compact 2>/dev/null" \
          | grep -E 'accessibilityText=[^ ;]|[^a-z]text=|resource-id=' | grep -v 'scroll bar' \
          | sed -E 's/^[0-9]+,[0-9]+,"//; s/; enabled=[a-z]+//g; s/",[0-9]*$//' | awk '!seen[$0]++' | head -"${1:-80}";;
      flow) # <flow.yaml | dir of flows on this host>: Maestro taps/types/swipes/asserts on the booted simulator
        f=${1:?mac sim <name> flow <flow.yaml|dir>}; [ -e "$f" ] || die "no flow $f"
        remote "$n" "mkdir -p $art/flow" && rsync -r -e "ssh ${SSHO[*]}" "$f" "$(target "$n"):$art/flow/" || die "flow upload failed"
        remote "$n" "$booted; $java; cd $art && maestro --device \$dev test flow/$(basename "$f") --format junit --output report.xml --debug-output debug --test-output-dir shots"; rc=$?
        pull; exit $rc;;
      run) # <worktree> [--path <app dir>]: the framework's own dev run (flutter run / expo run:ios / react-native run-ios)
        # on the booted simulator, left running in the background on the Mac (hot reload, Metro). Returns once the app is up.
        src=${1:?mac sim <name> run <worktree> [--path <app dir>]}; lock "$n" "$src"; rdir=$(sync_to "$n" "$src") || exit 1
        st="$w/.runs/$(repo_key "$src")"
        remote "$n" "$booted
          st=$(printf %q "$st"); case \$st in /*) ;; *) st=\$HOME/\$st;; esac; mkdir -p \$st; [ -f \$st/pgid ] && { kill -- -\$(cat \$st/pgid) 2>/dev/null; sleep 2; }
          cd $(printf %q "$rdir/$sub") || exit 1
          if [ -f pubspec.yaml ]; then kind=flutter; cmd=\"flutter run -d \$dev\"; ready='Flutter run key commands|Dart VM Service .* is available'
          elif [ -f package.json ] && grep -q '\"expo\"' package.json; then kind=expo; cmd=\"npx expo run:ios --device \$dev\"; ready='Logs for your project will appear|Opening on'
          elif [ -f package.json ] && grep -q '\"react-native\"' package.json; then kind=rn; cmd=\"npx react-native run-ios --udid \$dev\"; ready='Successfully launched the app'
          else echo 'no Flutter, Expo or React Native app here: use mac build (native) or --path <app dir>'; exit 3; fi
          if [ \$kind != flutter ]; then   # JS deps with the repo's own lockfile, only when package.json or the lockfile moved
            lf=\$(ls pnpm-lock.yaml yarn.lock package-lock.json 2>/dev/null | head -1); h=\$(cat package.json \$lf | shasum | cut -c1-12)
            if [ ! -d node_modules ] || [ \"\$(cat \$st/deps 2>/dev/null)\" != \"\$h\" ]; then echo \"installing JS deps (\${lf:-npm})\"
              case \$lf in pnpm-lock.yaml) pnpm install --frozen-lockfile;; yarn.lock) yarn install --frozen-lockfile;; *) npm ci;; esac > \$st/install.log 2>&1 || { tail -20 \$st/install.log; exit 1; }
              echo \$h > \$st/deps; fi
          fi
          rm -f \$st/in; mkfifo \$st/in; : > \$st/log; echo \$kind > \$st/kind
          # new session (setsid): own process group that stop kills whole, detached from this ssh session
          rm -f \$st/pgid; ( exec 3<>\$st/in; exec python3 -c 'import os,sys; os.setsid(); open(sys.argv[1],\"w\").write(str(os.getpid())); os.execvp(sys.argv[2], sys.argv[2:])' \$st/pgid \${=cmd} <&3 > \$st/log 2>&1 ) &!
          for i in 1 2 3 4 5; do [ -s \$st/pgid ] && break; sleep 1; done
          echo \"\$kind: \$cmd (log on the Mac: \$st/log)\"
          for i in {1..300}; do
            grep -q -E \"\$ready\" \$st/log && { echo 'app running'; grep -E 'Error|error:|Exception' \$st/log | tail -3; exit 0; }
            kill -0 \$(cat \$st/pgid) 2>/dev/null || { echo 'run exited:'; grep -E 'rror|xception|FAILED' \$st/log | sort -u | head -12; tail -8 \$st/log; exit 1; }
            sleep 3; done; echo 'still starting after 15 min: mac sim <mac> logs'; exit 2";;
      reload) # <worktree>: sync the latest code into the running session; Flutter hot reload (r), Metro refreshes by itself
        src=${1:?mac sim <name> reload <worktree>}; lock "$n" "$src"; sync_to "$n" "$src" >/dev/null || exit 1; st="$w/.runs/$(repo_key "$src")"
        remote "$n" "st=$(printf %q "$st"); case \$st in /*) ;; *) st=\$HOME/\$st;; esac; kill -0 \$(cat \$st/pgid 2>/dev/null) 2>/dev/null || { echo 'no session running: mac sim <mac> run'; exit 3; }
          [ \"\$(cat \$st/kind)\" = flutter ] && kill -USR1 \$(cat \$st/pgid); sleep 6; echo reloaded; grep -E 'Reloaded|Restarted|rror' \$st/log | tail -3";;
      stop|logs) # <repo|worktree> [lines]
        r=${1:?mac sim <name> $a <repo|worktree>}; [ -d "$r" ] && r=$(repo_key "$r"); st=$(printf %q "$w/.runs/$r")
        pre="st=$st; case \$st in /*) ;; *) st=\$HOME/\$st;; esac"
        if [ "$a" = stop ]; then remote "$n" "$pre; [ -f \$st/pgid ] && kill -- -\$(cat \$st/pgid) 2>/dev/null; rm -f \$st/pgid \$st/in; echo stopped"
        else remote "$n" "$pre; tail -n ${2:-60} \$st/log"; fi;;
      *) die "unknown sim action $a (mac help)";;
    esac;;
  help|*)
    cat <<'EOF'
mac: run Xcode/Swift/iOS/macOS work on a real Mac from this Linux host (it cannot build Apple targets itself).
  mac  (= mac list)                         FIRST STEP: registered Macs, online/offline (Tailscale), unregistered tailnet
                                            Macs. Exit 1 + "no Mac online: nothing to do" when none is online: then stop
  mac check [name]...                       reachable? macOS, Xcode version, free disk
  mac add <name> --host <h> --user <u> [--workdir <dir>] [--note <text>]   host = Tailscale name or 100.x IP
  mac edit <name> [--host|--user|--workdir|--note <v>]
  mac remove <name>
  mac pubkey                                key + one-liner to authorise this host on a new Mac
  mac sync <name> <dir>                     rsync a worktree into the Mac's one clone of that repo, <workdir>/<repo>;
                                            .gitignore'd paths are never sent nor deleted (Mac-generated build output stays);
                                            --with-env (sync, build, sim run) also sends .env* and Firebase plists: only
                                            when the requester allowed their values on that Mac
                                            (repo = origin remote name; reused by every task, so builds stay warm; no .git, node_modules,
                                            top-level build/, Pods/: build runs pod install on the Mac when Podfile.lock changes);
                                            prints the remote dir. React Native/Flutter: run
                                            `npm ci` / `flutter pub get` there with mac run before building
  mac build <name> <dir> [--path <subdir>] [--scheme S] [--dest D] [-- extra xcodebuild args]
                                            sync <dir>, then xcodebuild in <dir>/<subdir> (workspace over project, first scheme by default,
                                            generic iOS Simulator, Mac-native arch only, no signing); prints the command,
                                            errors, BUILD SUCCEEDED/FAILED and a log path under ~/mac-logs; exit code = xcodebuild's
  mac sim <name> devices | boot [device] [--except health,store] | shutdown
                                            boot = always a slim simulator (simslim, ~4x less RAM), opens its window;
                                            --except keeps daemon categories the app needs (health, store = push, icloud ...)
  mac sim <name> install|reinstall|launch|terminate <repo|worktree> [--config Debug-Dev]
                                            the app from that repo's last `mac build`; reinstall = uninstall + install +
                                            launch (fresh app data); launch relaunches when running
  mac sim <name> run <worktree> [--path <app dir>] [--with-env]
                                            Flutter / Expo / React Native: the framework's own run (flutter run, npx expo
                                            run:ios, react-native run-ios) on the booted simulator, kept running on the Mac
                                            (Metro, hot reload); returns when the app is up. Native Xcode apps: mac build + install
  mac sim <name> reload <worktree>          push your latest code into that running session (Flutter hot reload via SIGUSR1, Metro refreshes itself)
  mac sim <name> stop|logs <repo|worktree> [lines]
  mac sim <name> screenshot | openurl <url> | hierarchy [lines]
                                            screenshot lands on this host (path printed); hierarchy = labelled UI elements + bounds
  mac sim <name> flow <flow.yaml|dir>       Maestro flow (tapOn, inputText, swipe, assertVisible, takeScreenshot ...) on the
                                            booted simulator; report + screenshots come back to ~/mac-logs/sim/<ts>
                                            One simulator per Mac, shared: sim commands wait their turn.
  mac run <name> -- <command>               any command in a login zsh from the Mac's workdir (swift test, flutter
                                            build ios --no-codesign, xcrun simctl ..., pod install)
Rules: build from your worktree, never edit files on the Mac (sync overwrites). No signing, no App Store/TestFlight upload,
no keychain, no installing on the Mac without the requester asking. A Mac that fails `check` is offline: say so in the
handoff (`not covered: iOS build, no Mac online`), never wait for it; run/sync/build refuse offline Macs. Adding a Mac: Tailscale + Remote Login on it,
`mac add`, run the `mac pubkey` line there, `mac check <name>`.
EOF
