#!/usr/bin/env python3
"""preview-stack: one integrated preview for a task that spans several repos (-> /usr/local/bin/preview-stack).

A stack = named members, each a running process:
  app      public web app or API, served through preview-url (production build, router, TLS) at
           https://<task>[-<name>].187-126-114-172.sslip.io  (the primary app gets the bare https://<task>.…)
  service  anything else long-running (mongod, redis-server, a worker): local port only, never public.
Members wire together through placeholders in env and cmd: {{url:api}} {{port:mongo}} {{host}} {{data:mongo}}
{{dir:web}} {{task}}. Env reaches the build and the server and beats .env* files (Next, CRA, Vite).

Run `preview-stack guide` for the agent manual, `preview-stack help` for the command list.
"""
import fcntl, hashlib, json, os, re, shlex, signal, socket, subprocess, sys, time
from contextlib import contextmanager
from datetime import datetime, timezone

ROOT = os.environ.get("PREVIEW_STACK_ROOT", "/home/paperclip/preview-stacks")
RECIPES = os.environ.get("PREVIEW_STACK_RECIPES", "/home/paperclip/preview-stack.d")
PREVIEW_URL = os.environ.get("PREVIEW_URL_BIN", "/usr/local/bin/preview-url")
BASE = os.environ.get("PREVIEW_BASE_HOST", "187-126-114-172.sslip.io")
ENV_FILES = [".env", ".env.local", ".env.development", ".env.development.local", ".env.production", ".env.production.local"]
MEMBER_KEYS = {"dir", "cmd", "kind", "primary", "env", "after", "ready", "workspace", "devUrl", "notes"}
SECRETISH = re.compile(r"secret|token|pass|pwd|key|auth|private|credential|dsn", re.I)
PH = re.compile(r"\{\{(url|port|data|dir|host|task)(?::([a-zA-Z0-9_-]+))?\}\}")

HELP = """usage: preview-stack <command> ...

  init <TASK>                                   create an empty stack (GRA-300)
  add <TASK> <name> [options]                   add or replace a member (recipe for its workspace merged first)
      --dir PATH        worktree / working dir (apps: required; services: default = its data dir)
      --cmd CMD         serve command (apps: omit = preview-url auto-detect, production build)
      --service         local-only process (mongod, redis-server, worker); default kind is app
      --primary         this app gets https://<task>.<host>
      --env K=V         repeatable; placeholders allowed
      --after NAME      repeatable; start after NAME is ready
      --ready SPEC      tcp | http:/path | cmd:<shell> | preview (apps default: preview-url ready + port answers)
      --workspace NAME  recipe to merge (default: repo name of --dir)
      --dev-url URL     deployed URL this member replaces: other members' env values pointing at it are rewritten
